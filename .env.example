# ---------------------------------------------------------------------------
# ONLYFURN — WordPress / WooCommerce connection
# Copy to `.env` and fill in real values. `.env` is gitignored; never commit it.
# Every variable here is read server-side only (no PUBLIC_ prefix), so none of
# them are ever bundled into client-side JavaScript.
# ---------------------------------------------------------------------------

# Origin of the WordPress install, without a trailing slash.
# REST root: https://onlyfurn.co.za/wp-json/
WORDPRESS_URL=https://onlyfurn.co.za

# WooCommerce REST API keys — WooCommerce > Settings > Advanced > REST API.
# Used as HTTP Basic auth for /wp-json/wc/v3/* (orders, customers, coupons,
# stock). Leave both blank to run catalogue-only on the public Store API.
WC_CONSUMER_KEY=
WC_CONSUMER_SECRET=

# Customer authentication. The site currently has NO JWT plugin installed, so
# /wp-json/jwt-auth/v1/token returns 404. Point this at whichever token endpoint
# you enable. See README "Customer accounts" for options.
#   JWT plugin:  https://onlyfurn.co.za/wp-json/jwt-auth/v1/token
WC_AUTH_TOKEN_ENDPOINT=https://onlyfurn.co.za/wp-json/jwt-auth/v1/token

# Optional: WP username, used only to mint Application Passwords during the
# one-time https://onlyfurn.co.za/wp-admin/authorize-application.php handshake.
WP_USERNAME=
WP_APP_PASSWORD=

# Seconds a catalogue GET stays in the in-process cache. 0 disables caching.
WORDPRESS_CACHE_TTL=300
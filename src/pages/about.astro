---
import { Image } from "astro:assets";
import BaseLayout from "@/layouts/BaseLayout.astro";
import handsImg from "@/assets/atelier-hands.jpg";
import workshopImg from "@/assets/atelier-workshop.jpg";
import { siteConfig, pageTitle } from "@/config/site";
import { getProducts } from "@/data/products";

const products = await getProducts();

const principles = [
  {
    heading: "Solid timber, always",
    copy: "No MDF, no veneer, no engineered cores where it matters. Every surface you see and touch is real timber, all the way through.",
  },
  {
    heading: "Built for long days",
    copy: "Office seating is engineered around a supportive frame and a mesh or padded seat that stays comfortable from the first email to the last meeting.",
  },
  {
    heading: "Priced honestly",
    copy: "The price you see is the price you pay. Nationwide delivery is quoted up front at checkout — no surprises on the invoice.",
  },
];

const inStock = products.filter((product) => product.inStock).length;

const facts = [
  { value: String(products.length).padStart(2, "0"), label: "Pieces" },
  { value: String(new Set(products.map((p) => p.collection)).size).padStart(2, "0"), label: "Ranges" },
  { value: String(inStock).padStart(2, "0"), label: "In stock now" },
  { value: siteConfig.location.country, label: "Ships from" },
];
---

<BaseLayout
  title={pageTitle("The Studio")}
  description="Onlyfurn designs dining and office furniture in South Africa. Solid timber seating built to last, with nationwide delivery."
  image={workshopImg}
>
  <main id="main-content">
    <section class="shell pb-12 pt-12 md:pb-16 md:pt-20">
      <h1 class="type-h1 hero-in max-w-[13ch]">Seating that earns its keep</h1>
      <p class="type-lead hero-in mt-8 max-w-[58ch]" style="--reveal-delay:120ms">
        Onlyfurn designs a small catalogue of dining and office seating in South Africa. Solid timber, honest
        construction, and a straightforward price — built for rooms people actually use, and shipped nationwide.
      </p>
    </section>

    <figure class="hero-in overflow-hidden bg-surface" style="--reveal-delay:260ms">
      <Image
        src={workshopImg}
        alt="Sunlit furniture workshop with hand tools and a half-finished chair"
        width={1920}
        height={1080}
        format="webp"
        loading="eager"
        decoding="sync"
        class="parallax h-[50vh] w-full object-cover md:h-[72vh]"
      />
    </figure>

    {/* -------------------------------------------------------------- Origin */}
    <section class="shell mt-24 grid gap-8 md:mt-36 md:grid-cols-12">
      <div class="md:col-span-5" data-reveal>
        <h2 class="type-h2 max-w-[12ch]">We started with one chair</h2>
      </div>
      <div class="md:col-span-6 md:col-start-7" data-reveal style="--reveal-delay:120ms">
        <p class="type-body">
          Onlyfurn began with a single dining chair and a frustration: good seating was either imported at a price
          that made you wince, or flat-packed from an engineered core that started to fail within a few years. We
          wanted solid timber, delivered locally, at a price you could read at a glance.
        </p>
        <p class="type-body mt-5">
          The catalogue is intentionally small — {products.length} pieces across {new Set(products.map((p) => p.collection)).size} ranges. We'd rather do a few things well than offer a hundred we
          don't.
        </p>
      </div>
    </section>

    {/* ---------------------------------------------------------- Principles */}
    <section class="shell mt-24 md:mt-36">
      <div class="rule" data-reveal="line"></div>
      <h2 class="type-h2 mt-8 max-w-[16ch]" data-reveal>How we work</h2>

      <div class="mt-12 grid gap-x-8 gap-y-12 md:grid-cols-3">
        {
          principles.map((principle, index) => (
            <div class="border-t border-line pt-6" data-reveal style={`--reveal-delay:${index * 110}ms`}>
              <h3 class="type-h3">{principle.heading}</h3>
              <p class="type-body mt-4 text-[0.9375rem]">{principle.copy}</p>
            </div>
          ))
        }
      </div>
    </section>

    {/* ----------------------------------------------------------- Materials */}
    <section class="shell mt-24 grid items-center gap-10 md:mt-36 md:grid-cols-12 md:gap-12">
      <div class="md:col-span-5">
        <div class="overflow-hidden bg-surface" data-reveal="mask">
          <div>
            <Image
              src={handsImg}
              alt="Close-up of a craftsman's hands planing a piece of pale oak"
              width={1080}
              height={1440}
              format="webp"
              loading="lazy"
              class="aspect-[3/4] w-full object-cover"
            />
          </div>
        </div>
      </div>

      <div class="md:col-span-6 md:col-start-7" data-reveal style="--reveal-delay:140ms">
        <blockquote>
          <p class="type-h3 max-w-[26ch] text-[clamp(1.5rem,2.8vw,2.25rem)] leading-[1.15]">
            "A chair that creaks after two years has failed, no matter how good it looked on day one. We build for
            the tenth year."
          </p>
          <footer class="label mt-6">Onlyfurn — design and sourcing</footer>
        </blockquote>
        <p class="type-body mt-8 max-w-[48ch] border-t border-line pt-6 text-[0.9375rem]">
          Oak, walnut and painted timber across both ranges, sourced locally wherever possible and built by
          suppliers we have worked with for years. Every piece ships nationwide from {siteConfig.location.region},
          South Africa.
        </p>
      </div>
    </section>

    {/* --------------------------------------------------------------- Facts */}
    <section class="mt-24 border-y border-line md:mt-36" aria-label="Catalogue at a glance">
      <dl class="shell grid grid-cols-2 md:grid-cols-4">
        {
          facts.map((fact, index) => (
            <div class="fact" data-reveal style={`--reveal-delay:${index * 70}ms`}>
              <dt class="label">{fact.label}</dt>
              <dd class="mt-2.5 text-2xl font-medium tracking-[-0.03em] md:text-3xl">{fact.value}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    {/* ----------------------------------------------------------------- CTA */}
    <section id="studio" class="shell mt-24 md:mt-36">
      <div class="grid items-end gap-8 md:grid-cols-12" data-reveal>
        <div class="md:col-span-7">
          <h2 class="type-h2 max-w-[16ch]">Questions, or ready to begin with a piece</h2>
        </div>
        <div class="flex flex-wrap gap-3 md:col-span-5 md:justify-end">
          <a href="/catalog" class="btn btn-primary">See the catalogue</a>
          <a href={`mailto:${siteConfig.email}`} class="btn btn-outline">Write to us</a>
        </div>
      </div>
    </section>
  </main>

</BaseLayout>
